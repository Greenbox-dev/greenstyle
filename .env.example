# Copie para .env somente no ambiente local. Nunca publique senhas reais.
SECRET_KEY=gere-uma-chave-aleatoria-longa
ADMIN_EMAIL=seu-email@example.com
# Gere com: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('SUA_SENHA_FORTE'))"
ADMIN_PASSWORD_HASH=cole-aqui-o-hash-gerado
DATABASE_PATH=instance/financeiro.db
COOKIE_SECURE=false
